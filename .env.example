ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://taskmate:CHANGE_ME@db:5432/taskmate
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
DOMAIN=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
DEFAULT_REMINDERS_MINUTES=1440,60

META_VERIFY_TOKEN=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v25.0
META_REMINDER_TEMPLATE=task_reminder
# Optional mapping when Meta's inbound wa_id differs from the accepted outbound recipient.
WHATSAPP_RECIPIENT_OVERRIDES={}

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GMAIL_CREDENTIALS_FILE=/run/secrets/google-oauth.json
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_PUBSUB_AUDIENCE=https://bot.example.com/webhooks/gmail
GMAIL_PUBSUB_TOPIC=projects/PROJECT/topics/gmail-notifications
GMAIL_BOT_ADDRESS=bot@example.com

SERVICE_TOKEN=CHANGE_ME
